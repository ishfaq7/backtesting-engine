# Copy this file to .env and fill in real values. Never commit the real .env file.

# CoinGlass API credentials
COINGLASS_API_KEY=

# Optional overrides (defaults shown)
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_TIMEOUT_SECONDS=10
COINGLASS_MAX_RETRIES=5
COINGLASS_BACKOFF_BASE_SECONDS=0.5
COINGLASS_BACKOFF_MAX_SECONDS=30
COINGLASS_RATE_LIMIT_REQUESTS=30
COINGLASS_RATE_LIMIT_PERIOD_SECONDS=60

# Local data cache location
BTENGINE_DATA_CACHE_DIR=./data_cache
